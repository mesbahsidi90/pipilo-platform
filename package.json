  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "lucide-react": "0.468.0",
    "qrcode.react": "4.2.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.13",
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "3.3.3",
    "tailwindcss": "4.1.13",
    "vite": "7.3.7"
  }
}
