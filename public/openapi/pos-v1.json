{
  "openapi": "3.1.0",
  "info": {
    "title": "Bipilo POS API",
    "version": "1.0.0",
    "description": "Server-to-server API for cashier (POS) systems. One key per branch, created by the shop owner in Dashboard → Features → Cashier link. Requests sent from a browser (with an Origin header) are refused."
  },
  "servers": [
    {
      "url": "https://kdvtqlqiervznhzbpjcx.supabase.co/functions/v1/pos-api/v1"
    }
  ],
  "security": [
    {
      "posKey": []
    }
  ],
  "paths": {
    "/branches": {
      "get": {
        "summary": "Succursale de la clé",
        "x-summary-ar": "الفرع تاع المفتاح",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Branch"
                      }
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "code": "0b6f3a9e-2c41-4d7b-8e15-6a2f9c0d4b71",
                      "name": "Café Centre",
                      "active": true
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or revoked key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_key"
                }
              }
            }
          },
          "429": {
            "description": "More than 120 calls a minute with this key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "rate_limit"
                }
              }
            }
          }
        }
      }
    },
    "/tickets": {
      "post": {
        "summary": "Créer un ticket",
        "x-summary-ar": "إنشاء تيكي",
        "description": "Idempotent by externalRef: sending the same externalRef again returns the existing ticket with 200. Without number, Bipilo gives the next free number of the day.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTicket"
              },
              "example": {
                "externalRef": "INV-2026-000123",
                "number": "42",
                "customerName": "Amine"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Already created with this externalRef",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                },
                "example": {
                  "id": "7d3f1c2a-5b8e-4f0a-9c61-2e4b8a9d0f13",
                  "number": "42",
                  "branchCode": "0b6f3a9e-2c41-4d7b-8e15-6a2f9c0d4b71",
                  "externalRef": "INV-2026-000123",
                  "status": "preparing",
                  "customerName": "Amine",
                  "trackingUrl": "https://bipilo.app/#track/3c9a1e57-0d2b-4f86-b4a1-9e7c2d5f8a10",
                  "createdAt": "2026-11-19T09:41:00Z",
                  "readyAt": null,
                  "collectedAt": null
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                },
                "example": {
                  "id": "7d3f1c2a-5b8e-4f0a-9c61-2e4b8a9d0f13",
                  "number": "42",
                  "branchCode": "0b6f3a9e-2c41-4d7b-8e15-6a2f9c0d4b71",
                  "externalRef": "INV-2026-000123",
                  "status": "preparing",
                  "customerName": "Amine",
                  "trackingUrl": "https://bipilo.app/#track/3c9a1e57-0d2b-4f86-b4a1-9e7c2d5f8a10",
                  "createdAt": "2026-11-19T09:41:00Z",
                  "readyAt": null,
                  "collectedAt": null
                }
              }
            }
          },
          "400": {
            "description": "Body is not a JSON object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_json"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or revoked key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_key"
                }
              }
            }
          },
          "403": {
            "description": "Branch is not on a paid plan, or is inactive (branch_inactive)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "plan_required"
                }
              }
            }
          },
          "404": {
            "description": "branchCode is not the branch of this key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "branch_not_found"
                }
              }
            }
          },
          "409": {
            "description": "Another open ticket already has this number",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "number_in_use"
                }
              }
            }
          },
          "422": {
            "description": "number must be 1–9999 (also invalid_external_ref)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_number"
                }
              }
            }
          },
          "429": {
            "description": "More than 120 calls a minute with this key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "rate_limit"
                }
              }
            }
          }
        }
      }
    },
    "/tickets/{ticket}": {
      "get": {
        "summary": "Consulter un ticket",
        "x-summary-ar": "شوف حالة التيكي",
        "parameters": [
          {
            "$ref": "#/components/parameters/Ticket"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
