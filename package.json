{
  "name": "bippo-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"tests/**/*.js\" \"supabase/functions/**/*.{ts,js}\" vite.config.js",
