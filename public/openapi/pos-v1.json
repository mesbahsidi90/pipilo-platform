                  "$ref": "#/components/schemas/Ticket"
                },
                "example": {
                  "id": "7d3f1c2a-5b8e-4f0a-9c61-2e4b8a9d0f13",
                  "number": "42",
                  "branchCode": "0b6f3a9e-2c41-4d7b-8e15-6a2f9c0d4b71",
                  "externalRef": "INV-2026-000123",
                  "status": "preparing",
                  "customerName": "Amine",
                  "trackingUrl": "https://bipilo.app/#track/3c9a1e57-0d2b-4f86-b4a1-9e7c2d5f8a10",
                  "createdAt": "2026-11-19T09:41:00Z",
                  "readyAt": null,
                  "collectedAt": null
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or revoked key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_key"
                }
              }
            }
          },
          "403": {
            "description": "Branch is not on a paid plan, or is inactive (branch_inactive)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "plan_required"
                }
              }
            }
          },
          "404": {
            "description": "No ticket with this id or externalRef",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "ticket_not_found"
                }
              }
            }
          },
          "429": {
            "description": "More than 120 calls a minute with this key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "rate_limit"
                }
              }
            }
          }
        }
      }
    },
    "/tickets/{ticket}/ready": {
      "post": {
        "summary": "Signaler que le ticket est prêt",
        "x-summary-ar": "علّم التيكي «جاهز» (تليفون الزبون يصوني)",
        "parameters": [
          {
            "$ref": "#/components/parameters/Ticket"
          }
        ],
        "responses": {
          "200": {
            "description": "Updated (or already in that status)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                },
                "example": {
                  "id": "7d3f1c2a-5b8e-4f0a-9c61-2e4b8a9d0f13",
                  "number": "42",
                  "branchCode": "0b6f3a9e-2c41-4d7b-8e15-6a2f9c0d4b71",
                  "externalRef": "INV-2026-000123",
                  "status": "ready",
                  "customerName": "Amine",
                  "trackingUrl": "https://bipilo.app/#track/3c9a1e57-0d2b-4f86-b4a1-9e7c2d5f8a10",
                  "createdAt": "2026-11-19T09:41:00Z",
                  "readyAt": "2026-11-19T09:52:00Z",
                  "collectedAt": null
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or revoked key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_key"
                }
              }
            }
          },
          "403": {
            "description": "Branch is not on a paid plan, or is inactive (branch_inactive)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "plan_required"
                }
              }
            }
          },
          "404": {
            "description": "No ticket with this id or externalRef",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "ticket_not_found"
                }
              }
            }
          },
          "409": {
            "description": "Only a preparing ticket can become ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_transition"
                }
              }
            }
          },
          "429": {
            "description": "More than 120 calls a minute with this key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "rate_limit"
                }
              }
            }
          }
        }
      }
    },
    "/tickets/{ticket}/complete": {
      "post": {
        "summary": "Confirmer la remise",
        "x-summary-ar": "علّم التيكي «تسلّم»",
        "parameters": [
          {
            "$ref": "#/components/parameters/Ticket"
          }
        ],
        "responses": {
          "200": {
            "description": "Updated (or already in that status)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                },
                "example": {
                  "id": "7d3f1c2a-5b8e-4f0a-9c61-2e4b8a9d0f13",
                  "number": "42",
                  "branchCode": "0b6f3a9e-2c41-4d7b-8e15-6a2f9c0d4b71",
                  "externalRef": "INV-2026-000123",
                  "status": "collected",
                  "customerName": "Amine",
                  "trackingUrl": "https://bipilo.app/#track/3c9a1e57-0d2b-4f86-b4a1-9e7c2d5f8a10",
                  "createdAt": "2026-11-19T09:41:00Z",
                  "readyAt": "2026-11-19T09:52:00Z",
                  "collectedAt": "2026-11-19T09:55:00Z"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or revoked key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_key"
                }
              }
            }
          },
          "403": {
            "description": "Branch is not on a paid plan, or is inactive (branch_inactive)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "plan_required"
                }
              }
            }
          },
          "404": {
            "description": "No ticket with this id or externalRef",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "ticket_not_found"
                }
              }
            }
          },
          "409": {
            "description": "Only a ready ticket can be collected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_transition"
                }
              }
            }
          },
          "429": {
            "description": "More than 120 calls a minute with this key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "rate_limit"
                }
              }
            }
          }
        }
      }
    },
    "/tickets/{ticket}/cancel": {
      "post": {
        "summary": "Annuler le ticket",
        "x-summary-ar": "ألغي التيكي",
        "parameters": [
          {
            "$ref": "#/components/parameters/Ticket"
          }
        ],
        "responses": {
          "200": {
            "description": "Updated (or already in that status)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                },
                "example": {
                  "id": "7d3f1c2a-5b8e-4f0a-9c61-2e4b8a9d0f13",
                  "number": "42",
                  "branchCode": "0b6f3a9e-2c41-4d7b-8e15-6a2f9c0d4b71",
                  "externalRef": "INV-2026-000123",
                  "status": "cancelled",
                  "customerName": "Amine",
                  "trackingUrl": "https://bipilo.app/#track/3c9a1e57-0d2b-4f86-b4a1-9e7c2d5f8a10",
                  "createdAt": "2026-11-19T09:41:00Z",
                  "readyAt": null,
                  "collectedAt": null
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or revoked key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_key"
                }
              }
            }
          },
          "403": {
            "description": "Branch is not on a paid plan, or is inactive (branch_inactive)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "plan_required"
                }
              }
            }
          },
          "404": {
            "description": "No ticket with this id or externalRef",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "ticket_not_found"
                }
              }
            }
          },
          "409": {
            "description": "Only a preparing ticket can be cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "invalid_transition"
                }
              }
            }
          },
          "429": {
            "description": "More than 120 calls a minute with this key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "rate_limit"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "posKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Branch key: Authorization: Bearer bpk_…  Keep it on the server."
      }
    },
    "parameters": {
      "Ticket": {
        "name": "ticket",
        "in": "path",
        "required": true,
        "description": "Bipilo ticket id, or your own externalRef (URL-encoded).",
        "schema": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "schemas": {
      "Branch": {
        "type": "object",
        "required": [
          "code",
          "name",
          "active"
        ],
        "properties": {
          "code": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "CreateTicket": {
        "type": "object",
        "required": [
          "externalRef"
        ],
        "properties": {
          "externalRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Your receipt/order id. Unique per branch."
          },
          "number": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,3}$",
            "description": "Number shown to the customer. Optional."
          },
          "customerName": {
            "type": "string",
            "maxLength": 40
          },
          "branchCode": {
            "type": "string",
            "format": "uuid",
            "description": "Optional check."
          }
        }
      },
      "Ticket": {
        "type": "object",
        "required": [
          "id",
          "number",
          "branchCode",
          "externalRef",
          "status",
          "trackingUrl"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "number": {
            "type": "string"
          },
          "branchCode": {
            "type": "string",
            "format": "uuid"
          },
          "externalRef": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "preparing",
              "ready",
              "collected",
              "cancelled"
            ]
          },
          "customerName": {
            "type": [
              "string",
              "null"
            ]
          },
          "trackingUrl": {
            "type": "string",
            "format": "uri",
            "description": "Print it as a QR code on the receipt."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "readyAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "collectedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
